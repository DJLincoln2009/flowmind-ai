# ===== Développement local (valeurs par défaut) =====
FLOWMIND_DATABASE_URL=sqlite+aiosqlite:///./flowmind.db
FLOWMIND_JWT_SECRET=changez-moi-avec-une-secret-32-bytes-minimum
FLOWMIND_DEBUG=false
FLOWMIND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===== Production (Neon Postgres + Railway) =====
# FLOWMIND_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host-neon>:5432/<dbname>?sslmode=require
# FLOWMIND_JWT_SECRET=<secret long aléatoire — ex. "openssl rand -hex 32">
# FLOWMIND_CORS_ORIGINS=["https://flowmind-ai.vercel.app"]
# (les préviews https://<projet>.vercel.app sont autorisées par regex — voir app/main.py)

# ===== Clés IA (chaîne de fallback : gemini → openrouter → groq → mistral) =====
# FLOWMIND_GEMINI_API_KEY=AIza...
# FLOWMIND_OPENROUTER_API_KEY=sk-or-...
# FLOWMIND_GROQ_API_KEY=gsk_...
# FLOWMIND_MISTRAL_API_KEY=...
# FLOWMIND_OCRSPACE_API_KEY=K...
# FLOWMIND_AI_PRIMARY=gemini

# ===== Notifications email (optionnel — no-op sans ces valeurs) =====
# FLOWMIND_SMTP_HOST=smtp.mailtrap.io
# FLOWMIND_SMTP_PORT=587
# FLOWMIND_SMTP_SSL=false
# FLOWMIND_SMTP_USERNAME=...
# FLOWMIND_SMTP_PASSWORD=...
# FLOWMIND_SMTP_FROM=FlowMind <no-reply@flowmind.app>
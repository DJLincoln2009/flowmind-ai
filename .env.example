# Variables locales FlowMind AI — copier vers `.env` et adapter.
# Aucun secret nécessaire pour le démarrage local (valeurs dev par défaut).

# --- Base de données ---
# Local : SQLite. Production Railway : postgres://... (simple changement d'URL)
FLOWMIND_DATABASE_URL=sqlite+aiosqlite:////data/flowmind.db

# --- Sécurité (OBLIGATOIRE : changer en production) ---
FLOWMIND_JWT_SECRET=dev-secret-a-remplacer-en-production-32-bytes-min

# --- Clés IA (optionnel en local — chaîne de fallback) ---
FLOWMIND_GEMINI_API_KEY=
FLOWMIND_OPENROUTER_API_KEY=
FLOWMIND_GROQ_API_KEY=
FLOWMIND_MISTRAL_API_KEY=
FLOWMIND_OCRSPACE_API_KEY=

# Fournisseur IA primaire : gemini | openrouter | groq | mistral
FLOWMIND_AI_PRIMARY=gemini

# --- Notifications email (optionnel : SMTP best-effort) ---
FLOWMIND_SMTP_HOST=
FLOWMIND_SMTP_PORT=587
FLOWMIND_SMTP_SSL=false
FLOWMIND_SMTP_USERNAME=
FLOWMIND_SMTP_PASSWORD=
FLOWMIND_SMTP_FROM=

# --- CORS (frontend) ---
# FLOWMIND_CORS_ORIGINS=["http://localhost:3000","https://.vercel.app"]

# --- Web ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api